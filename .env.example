# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Put the database name after the host, e.g. ...mongodb.net/student-management?...
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/student-management?retryWrites=true&w=majority

# Port for local development (Render sets PORT automatically).
# 5050 rather than 5000 because macOS AirPlay Receiver already uses port 5000.
PORT=5050

# Optional: only needed if the frontend is hosted on a different domain (comma-separated)
# CLIENT_URL=http://localhost:3000
